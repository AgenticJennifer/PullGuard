# PullGuard environment template
# Copy to .env for local development. Do not commit real tokens.

# GitHub webhook/API integration
GITHUB_TOKEN=ghp_example_token_for_local_testing
GITHUB_WEBHOOK_SECRET=change-me
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY_PATH=

# LLM provider selection
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Runtime configuration
PULLGUARD_CONFIG=config/thresholds.yaml
PULLGUARD_LOG_LEVEL=INFO
PULLGUARD_DB_PATH=.pullguard/pullguard.sqlite3
